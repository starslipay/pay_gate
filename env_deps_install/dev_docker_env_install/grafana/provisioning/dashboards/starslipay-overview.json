        "definition": "label_values(pay_biz_code_total{module=~\"$module\"}, method)",
        "includeAll": true,
        "multi": true,
        "name": "method",
        "options": [],
        "query": { "query": "label_values(pay_biz_code_total{module=~\"$module\"}, method)", "refId": "StandardVariableQuery" },
