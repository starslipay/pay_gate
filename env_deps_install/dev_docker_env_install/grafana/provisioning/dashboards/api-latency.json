    },
    {
      "type": "timeseries",
      "title": "网关接口耗时 ($quantile 分位)",
      "description": "按 path 分组的接口耗时分位数, 顶部可切换 P99/P95, 可选具体接口",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile($quantile, sum(rate(http_server_requests_duration_ms_bucket{path=~\"$gateway_api\"}[$__rate_interval])) by (le, path))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
